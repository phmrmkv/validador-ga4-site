---
import '@fontsource-variable/inter';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Idioma da página. */
  lang?: 'pt-BR' | 'en';
  /** Caminhos das versões da mesma página em cada idioma (gera os hreflang). */
  alternates?: { pt: string; en: string };
}

const { title, description, noindex = false, lang = 'pt-BR', alternates } = Astro.props;
const em = lang === 'en';
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagem = new URL('/og-image.jpg', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Tema antes da primeira pintura (sem piscar): preferência salva ou a do sistema.
      (function () {
        var d = document.documentElement;
        var m = window.matchMedia('(prefers-color-scheme: dark)');
        function salvo() {
          try { var v = localStorage.getItem('validador-ga4-tema'); return v === 'dark' || v === 'light' ? v : null; } catch (e) { return null; }
        }
        d.dataset.theme = salvo() || (m.matches ? 'dark' : 'light');
        function mudou(e) { if (!salvo()) d.dataset.theme = e.matches ? 'dark' : 'light'; }
        if (m.addEventListener) m.addEventListener('change', mudou);
        d.classList.add('js');
      })();
    </script>
    <meta name="theme-color" content="#edf0f4" />
    <script is:inline>
      if (document.documentElement.dataset.theme === 'dark') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0e131a');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates && <link rel="alternate" hreflang="pt-BR" href={new URL(alternates.pt, Astro.site)} />}
    {alternates && <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates.pt, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={em ? 'en_US' : 'pt_BR'} />
    <meta property="og:site_name" content="Validador GA4" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={em ? 'Validador GA4: a Chrome and Edge extension that checks GA4 tagging (in development)' : 'Validador GA4: extensão para Chrome e Edge que confere o tagueamento do GA4 (em desenvolvimento)'} />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <link rel="sitemap" href="/sitemap-index.xml" />}
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-carmim focus:px-4 focus:py-2 focus:font-bold focus:text-[var(--sobre-carmim)]"
      >{em ? 'Skip to content' : 'Pular para o conteúdo'}</a
    >
    <slot name="topo" />
    <main id="conteudo">
      <slot />
    </main>
    <slot name="rodape" />
    <script>
      import '@/scripts/interacoes';
    </script>
    <script is:inline>
      // Reveal ao rolar. Inline de propósito: se fosse um arquivo e ele falhasse,
      // o conteúdo com data-reveal ficaria invisível. data-reveal vai em blocos, nunca em seções inteiras.
      (function () {
        var alvos = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          alvos.forEach(function (el) { el.classList.add('is-shown'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entradas) {
            entradas.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('is-shown'); io.unobserve(e.target); }
            });
          },
          { threshold: 0, rootMargin: '0px 0px -8% 0px' },
        );
        alvos.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
