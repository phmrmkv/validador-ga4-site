---
import Logo from './Logo.astro';
import CreditoPHMR from './CreditoPHMR.astro';
---

<footer class="rodape">
  <div class="miolo rodape-grade">
    <div class="rodape-marca">
      <Logo />
      <p>Ferramenta em desenvolvimento pela PHMR Tech Solutions.</p>
      <p>
        O Validador GA4 não é um produto do Google. O nome GA4 aparece só para dizer com o que a extensão trabalha.
      </p>
    </div>
    <div class="rodape-credito">
      <CreditoPHMR fundo="escuro" />
    </div>
  </div>
</footer>
